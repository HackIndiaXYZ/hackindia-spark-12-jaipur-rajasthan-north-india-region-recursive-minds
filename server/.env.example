# Veilex Server Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key for fast VLM inference (primary)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Fallback (used when GROQ_API_KEY is not set or Groq fails)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
