{
  "manifest_version": 3,
  "name": "Veilex — Privacy Vision Agent",
  "version": "1.0.0",
  "description": "A privacy-preserving browser vision agent that redacts PII locally before sending sanitized context to an AI server for intelligent browser automation.",
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Veilex — Privacy Vision Agent"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "activate-veilex": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Activate Veilex privacy vision agent"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "lib/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
